---
import DocsLayout from '../layouts/DocsLayout.astro';
import QuickStartWizard from '../components/ui/QuickStartWizard';
---

<DocsLayout title="Claude Code Total — Interactive Docs" activeSection="quickstart">
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-bold mb-2">Claude Code Total</h1>
      <p class="text-lg text-surface-500 dark:text-surface-400">
        Interactive documentation for Claude Code CLI. Click any item to expand details and examples.
      </p>
    </div>

    <!-- Quick Start Tutorial -->
    <QuickStartWizard client:visible />

    <!-- Quick start cards -->
    <div class="grid gap-4 sm:grid-cols-2">
      <a href="/shortcuts" class="group p-5 rounded-xl border border-surface-200 dark:border-surface-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-2xl mb-2">⌨️</div>
        <h3 class="font-semibold mb-1 group-hover:text-primary-500 transition-colors">Keyboard Shortcuts</h3>
        <p class="text-sm text-surface-500 dark:text-surface-400">All shortcuts and key combinations</p>
      </a>
      <a href="/commands" class="group p-5 rounded-xl border border-surface-200 dark:border-surface-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-2xl mb-2">⚡</div>
        <h3 class="font-semibold mb-1 group-hover:text-primary-500 transition-colors">Slash Commands</h3>
        <p class="text-sm text-surface-500 dark:text-surface-400">Every command with examples</p>
      </a>
      <a href="/mcp" class="group p-5 rounded-xl border border-surface-200 dark:border-surface-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-2xl mb-2">🔌</div>
        <h3 class="font-semibold mb-1 group-hover:text-primary-500 transition-colors">MCP Servers</h3>
        <p class="text-sm text-surface-500 dark:text-surface-400">Model Context Protocol setup</p>
      </a>
      <a href="/memory" class="group p-5 rounded-xl border border-surface-200 dark:border-surface-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-2xl mb-2">🧠</div>
        <h3 class="font-semibold mb-1 group-hover:text-primary-500 transition-colors">Memory & Files</h3>
        <p class="text-sm text-surface-500 dark:text-surface-400">CLAUDE.md and auto-memory system</p>
      </a>
      <a href="/workflows" class="group p-5 rounded-xl border border-surface-200 dark:border-surface-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-2xl mb-2">🔄</div>
        <h3 class="font-semibold mb-1 group-hover:text-primary-500 transition-colors">Workflows & Tips</h3>
        <p class="text-sm text-surface-500 dark:text-surface-400">Plan Mode, Worktrees, Voice and more</p>
      </a>
      <a href="/configuration" class="group p-5 rounded-xl border border-surface-200 dark:border-surface-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-2xl mb-2">⚙️</div>
        <h3 class="font-semibold mb-1 group-hover:text-primary-500 transition-colors">Configuration</h3>
        <p class="text-sm text-surface-500 dark:text-surface-400">Config files, settings, env variables</p>
      </a>
      <a href="/skills" class="group p-5 rounded-xl border border-surface-200 dark:border-surface-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-2xl mb-2">🪄</div>
        <h3 class="font-semibold mb-1 group-hover:text-primary-500 transition-colors">Skills & Agents</h3>
        <p class="text-sm text-surface-500 dark:text-surface-400">Built-in and custom skills, agents</p>
      </a>
      <a href="/cli" class="group p-5 rounded-xl border border-surface-200 dark:border-surface-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-2xl mb-2">💻</div>
        <h3 class="font-semibold mb-1 group-hover:text-primary-500 transition-colors">CLI Reference</h3>
        <p class="text-sm text-surface-500 dark:text-surface-400">Commands, flags, permission modes</p>
      </a>
    </div>

    <div class="p-4 rounded-lg bg-surface-100 dark:bg-surface-900 text-sm text-surface-500 dark:text-surface-400">
      <p>Use the toggles in the header to switch between <strong>Beginner/Advanced</strong> mode and <strong>EN/RO</strong> language. Your preferences are saved automatically.</p>
    </div>
  </div>
</DocsLayout>
