---
import DocsLayout from '../layouts/DocsLayout.astro';
import CommandGrid from '../components/ui/CommandGrid';
import { memoryCategories } from '../content/memory';
---

<DocsLayout title="Memory & Files — Claude Code Total" activeSection="memory">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold mb-2">🧠 Memory & Files</h1>
      <p class="text-surface-500 dark:text-surface-400">
        How Claude Code remembers context: CLAUDE.md files, rules system, and automatic memory.
      </p>
    </div>
    <CommandGrid client:visible categories={memoryCategories} />
  </div>
</DocsLayout>
